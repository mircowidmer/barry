# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/
# Deno writes it when it runs the deliver tests; deliver's deno.json pins exact versions
deno.lock

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

example

# MapLibre's worker, copied from node_modules on install (scripts/maplibre-worker.mjs)
/public/maplibre/

# generated native folders
/ios
/android

# verification proof (see .claude/skills/barry-backend-verify and barry-frontend-verify)
.verify-artifacts/

# Secrets for the local Supabase stack
supabase/.env
supabase/.env.hosted
# Written in a cloud session by .claude/hooks/session-start.sh, next to proxy-ca.pem (*.pem)
supabase/functions/.env
site/
