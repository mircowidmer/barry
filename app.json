{
  "expo": {
    "name": "Barry",
    "slug": "barry",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "barry",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "support.barry",
      "deploymentTarget": "26.0",
      "appleTeamId": "4GNTKX8XTQ",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "support.barry",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "./plugins/without-push",
      "./plugins/accent-color",
      "expo-router",
      [
        "@sentry/react-native/expo",
        { "url": "https://sentry.io", "organization": "mirco-widmer", "project": "barry" }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Barry opens the card of a contact you picked when a message to them did not arrive, so you can reach them yourself. It reads no other contact."
        }
      ],
      [
        "expo-font",
        {
          "ios": {
            "fonts": [
              "./assets/fonts/NordwandMono-Regular.ttf",
              "./assets/fonts/NordwandMono-Medium.ttf",
              "./assets/fonts/NordwandMono-SemiBold.ttf",
              "./assets/fonts/NordwandMono-Bold.ttf"
            ]
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF8F5",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "dark": {
            "backgroundColor": "#1C1A19"
          },
          "ios": {
            "image": "./assets/images/splash.png",
            "enableFullScreenImage_legacy": true,
            "resizeMode": "cover",
            "dark": {
              "image": "./assets/images/splash-dark.png",
              "backgroundColor": "#1C1A19"
            }
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Barry records where you are when you start an adventure or move its deadline, so an alert can tell your emergency contacts where to look.",
          "locationAlwaysAndWhenInUsePermission": "With Always, Barry records your trail about every 5 minutes until you check in, so your emergency contacts can follow it and an alert can show where you were last.",
          "locationAlwaysPermission": "With Always, Barry records your trail about every 5 minutes until you check in, so your emergency contacts can follow it and an alert can show where you were last.",
          "isIosBackgroundLocationEnabled": true,
          "motionUsagePermission": false,
          "locationFullAccuracyPermission": "Barry needs your precise location, so your trail and your last position show where you really are."
        }
      ],
      "expo-notifications",
      "expo-widgets",
      [
        "expo-localization",
        {
          "supportedLocales": [
            "en",
            "de"
          ]
        }
      ]
    ],
    "locales": {
      "de": "./locales/de.json"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "musharosky",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "9ed7a12e-44b5-4e36-831a-1e7a636033c7"
      }
    }
  }
}
