{
  "expo": {
    "name": "Barry",
    "slug": "barry",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "barry",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "support.barry"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "support.barry",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Barry records where you are when you start an Adventure or move its Deadline, so an Alert can tell your Emergency Contacts where to look.",
          "locationAlwaysAndWhenInUsePermission": "With Always, Barry records your Trail about once a minute until you check in, so your Emergency Contacts can follow it and an Alert can show where you were last.",
          "isIosBackgroundLocationEnabled": true
        }
      ],
      "expo-notifications",
      "expo-maps"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "mircowidmer",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "8fed6e1c-eaeb-41ea-ba83-eb841d3b08ee"
      }
    }
  }
}
