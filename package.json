{
  "name": "barry",
  "main": "index.ts",
  "version": "1.0.0",
  "dependencies": {
    "@expo/ui": "~58.0.17",
    "@react-native-community/datetimepicker": "9.2.1",
    "@supabase/supabase-js": "^2.117.3",
    "expo": "^58.0.10",
    "expo-constants": "~58.0.12",
    "expo-dev-client": "~58.0.14",
    "expo-font": "~58.0.8",
    "expo-glass-effect": "~58.0.3",
    "expo-image": "~58.0.14",
    "expo-linking": "~58.0.13",
    "expo-localization": "~58.0.4",
    "expo-location": "~58.0.16",
    "expo-maps": "~58.0.9",
    "expo-notifications": "~58.1.4",
    "expo-router": "~58.0.19",
    "expo-splash-screen": "~58.0.9",
    "expo-sqlite": "~58.0.13",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.5",
    "expo-task-manager": "~58.0.11",
    "leaflet": "^1.9.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0-rc.4",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.88.0-rc.4",
    "@types/leaflet": "^1.9.22",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jest": "~29.7.0",
    "jest-expo": "^58.0.10",
    "supabase": "^2.121.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "APP_VARIANT=development expo start --dev-client",
    "android": "APP_VARIANT=development expo run:android",
    "ios": "APP_VARIANT=development expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "jest",
    "e2e": "node --test --test-timeout=300000 'e2e/*.e2e.mjs'",
    "build:dev": "npx eas-cli@latest build --profile development --platform ios",
    "build:dev:simulator": "npx eas-cli@latest build --profile development-simulator --platform ios",
    "build:preview": "npx eas-cli@latest build --profile preview --platform ios",
    "build:production": "npx eas-cli@latest build --profile production --platform ios",
    "submit:production": "npx eas-cli@latest submit --profile production --platform ios --latest"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/supabase/",
      "/docs/",
      "/e2e/"
    ]
  }
}
