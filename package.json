{
  "name": "barry",
  "main": "index.ts",
  "version": "1.0.0",
  "dependencies": {
    "@expo/ui": "~58.0.28",
    "@maplibre/maplibre-gl-leaflet": "0.1",
    "@react-native-community/datetimepicker": "9.2.1",
    "@sentry/react-native": "~8.28.0",
    "@supabase/supabase-js": "2",
    "expo": "~58.0.25",
    "expo-constants": "~58.0.16",
    "expo-contacts": "~58.0.11",
    "expo-dev-client": "~58.0.20",
    "expo-font": "~58.0.12",
    "expo-glass-effect": "~58.0.5",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.17",
    "expo-localization": "~58.0.5",
    "expo-location": "~58.0.22",
    "expo-maps": "~58.0.11",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.31",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "~58.0.14",
    "expo-sqlite": "~58.0.17",
    "expo-symbols": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-task-manager": "~58.0.14",
    "expo-widgets": "~58.0.28",
    "leaflet": "1",
    "libphonenumber-js": "1",
    "maplibre-gl": "6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.88",
    "@types/leaflet": "1",
    "@types/react": "19",
    "eslint": "9",
    "eslint-config-expo": "~58.0.4",
    "jest": "30",
    "jest-expo": "~58.0.14",
    "supabase": "2",
    "typescript": "6"
  },
  "scripts": {
    "start": "APP_VARIANT=development expo start --dev-client",
    "android": "APP_VARIANT=development expo run:android",
    "ios": "APP_VARIANT=development expo run:ios",
    "iphone:production": "scripts/iphone-production.sh",
    "web": "expo start --web",
    "lint": "expo lint",
    "postinstall": "node scripts/maplibre-worker.mjs",
    "test": "jest",
    "e2e": "node --test --test-concurrency=12 --test-timeout=300000 'e2e/*.e2e.mjs'",
    "build:dev": "npx eas-cli@latest build --profile development --platform ios",
    "build:dev:simulator": "npx eas-cli@latest build --profile development-simulator --platform ios",
    "build:preview": "npx eas-cli@latest build --profile preview --platform ios",
    "build:production": "npx eas-cli@latest build --profile production --platform ios",
    "submit:production": "npx eas-cli@latest submit --profile production --platform ios --latest",
    "versions": "node scripts/version-ranges.mjs",
    "sentences": "node scripts/sentence-lines.mjs"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/supabase/",
      "/docs/",
      "/e2e/"
    ]
  }
}
