{
  "name": "barry",
  "main": "index.ts",
  "version": "1.0.0",
  "dependencies": {
    "@expo/ui": "58",
    "@maplibre/maplibre-gl-leaflet": "0.1",
    "@react-native-community/datetimepicker": "9.2.1",
    "@supabase/supabase-js": "2",
    "expo": "58",
    "expo-constants": "58",
    "expo-contacts": "58",
    "expo-dev-client": "58",
    "expo-font": "58",
    "expo-glass-effect": "58",
    "expo-image": "58",
    "expo-linking": "58",
    "expo-localization": "58",
    "expo-location": "58",
    "expo-maps": "58",
    "expo-notifications": "58",
    "expo-router": "58",
    "expo-secure-store": "58",
    "expo-splash-screen": "58",
    "expo-sqlite": "58",
    "expo-symbols": "58",
    "expo-system-ui": "58",
    "expo-task-manager": "58",
    "leaflet": "1",
    "libphonenumber-js": "1",
    "maplibre-gl": "6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "3",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5",
    "react-native-screens": "4",
    "react-native-web": "0.21",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.88",
    "@types/leaflet": "1",
    "@types/react": "19",
    "eslint": "10",
    "eslint-config-expo": "58",
    "jest": "30",
    "jest-expo": "58",
    "supabase": "2",
    "typescript": "6"
  },
  "scripts": {
    "start": "APP_VARIANT=development expo start --dev-client",
    "android": "APP_VARIANT=development expo run:android",
    "ios": "APP_VARIANT=development expo run:ios",
    "iphone:production": "scripts/iphone-production.sh",
    "web": "expo start --web",
    "lint": "expo lint",
    "postinstall": "node scripts/maplibre-worker.mjs",
    "test": "jest",
    "e2e": "node --test --test-concurrency=12 --test-timeout=300000 'e2e/*.e2e.mjs'",
    "build:dev": "npx eas-cli@latest build --profile development --platform ios",
    "build:dev:simulator": "npx eas-cli@latest build --profile development-simulator --platform ios",
    "build:preview": "npx eas-cli@latest build --profile preview --platform ios",
    "build:production": "npx eas-cli@latest build --profile production --platform ios",
    "submit:production": "npx eas-cli@latest submit --profile production --platform ios --latest",
    "versions": "node scripts/version-ranges.mjs"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/supabase/",
      "/docs/",
      "/e2e/"
    ]
  }
}
