{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests", "schedule:weekly"],
  "timezone": "Europe/Zurich",
  "minimumReleaseAge": "3 days",
  "customManagers": [
    {
      "customType": "regex",
      "description": "The Edge Function pins its npm and JSR imports inline",
      "managerFilePatterns": ["/^supabase/functions/.+\\.ts$/"],
      "matchStrings": ["['\"](?<datasource>npm|jsr):(?<depName>@?[^@'\"]+)@(?<currentValue>[^/'\"]+)"]
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "npm minor and patch updates"
    },
    {
      "description": "Expo SDK 58 pins these; update them with npx expo install --fix, or approve on the Dependency Dashboard",
      "matchPackageNames": ["expo", "expo-*", "@expo/*", "*-expo", "react", "react-dom", "react-native", "react-native-*", "@react-native/*", "@react-native-community/*", "@types/react", "typescript"],
      "groupName": "Expo SDK",
      "dependencyDashboardApproval": true
    },
    {
      "matchPackageNames": ["@supabase/supabase-js"],
      "groupName": "supabase-js"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    }
  ]
}
