{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests", "schedule:weekly"],
  "timezone": "Europe/Zurich",
  "minimumReleaseAge": "3 days",
  "osvVulnerabilityAlerts": true,
  "dependencyDashboardOSVVulnerabilitySummary": "unresolved",
  "vulnerabilityAlerts": { "automerge": true },
  "lockFileMaintenance": { "enabled": true, "automerge": true },
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "customManagers": [
    {
      "customType": "regex",
      "description": "The Edge Function pins its npm and JSR imports inline",
      "managerFilePatterns": ["/^supabase/functions/.+\\.ts$/"],
      "matchStrings": ["['\"](?<datasource>npm|jsr):(?<depName>@?[^@'\"]+)@(?<currentValue>[^/'\"]+)"]
    }
  ],
  "packageRules": [
    {
      "description": "Minor, patch and digest updates merge on their own once the checks that main requires pass, apart from the Expo SDK below",
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "automerge": true
    },
    {
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "npm minor and patch updates"
    },
    {
      "description": "Expo SDK 58 pins these; approve a patch on the Dependency Dashboard, but move to a new SDK with npx expo install --fix",
      "matchPackageNames": ["expo", "expo-*", "@expo/*", "*-expo", "react", "react-dom", "react-native", "react-native-*", "@react-native/*", "@react-native-community/*", "@types/react", "typescript"],
      "groupName": "Expo SDK",
      "dependencyDashboardApproval": true,
      "automerge": false
    },
    {
      "description": "A new CLI can change the generated database types, which CI checks, so it must not hold up the npm group",
      "matchPackageNames": ["supabase"],
      "groupName": "Supabase CLI"
    },
    {
      "matchPackageNames": ["@supabase/supabase-js"],
      "groupName": "supabase-js"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    }
  ]
}
