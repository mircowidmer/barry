{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests", "schedule:weekly"],
  "timezone": "Europe/Zurich",
  "minimumReleaseAge": "3 days",
  "osvVulnerabilityAlerts": true,
  "dependencyDashboardOSVVulnerabilitySummary": "unresolved",
  "vulnerabilityAlerts": { "automerge": true },
  "lockFileMaintenance": { "enabled": true, "automerge": true, "schedule": ["before 4am on tuesday"] },
  "postUpdateOptions": ["npmDedupe"],
  "configMigration": true,
  "packageRules": [
    {
      "description": "Safe to merge unseen because the ruleset on main requires the full CI first",
      "matchUpdateTypes": ["minor", "patch", "digest", "pinDigest"],
      "automerge": true
    },
    {
      "matchManagers": ["npm", "deno"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "weekly minor and patch updates"
    },
    {
      "description": "Expo pins these per SDK; a new SDK goes in with npx expo install --fix and npm run versions",
      "matchPackageNames": ["expo", "expo-*", "@expo/*", "*-expo", "react", "react-dom", "react-native", "react-native-*", "@react-native/*", "@react-native-community/*", "@sentry/react-native", "@types/react", "typescript"],
      "groupName": "Expo SDK",
      "dependencyDashboardApproval": true,
      "automerge": false
    },
    {
      "description": "A new CLI can change the generated database types, which CI checks, so it must not hold up the weekly group",
      "matchPackageNames": ["supabase"],
      "groupName": "Supabase CLI"
    },
    {
      "matchPackageNames": ["@supabase/supabase-js"],
      "groupName": "supabase-js"
    },
    {
      "description": "A new commit hash of an Action has no release date, so it would otherwise wait forever",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions",
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    }
  ]
}
